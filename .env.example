# AWS Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_ACCOUNT_ID=

# Environment (dev | prod)
ENVIRONMENT=

# Frontend (Vite)
VITE_API_URL=

# Development Tools (true | false)
# Enables debug keyboard shortcuts (Q/E zoom, F full map, R reset, L log position),
# floating HUD overlay with shortcut descriptions, and TileDebugScene.
# Set to "false" or remove in production to disable all dev tools.
VITE_DEV_TOOLS=false
